// Config for pipeline/contaminant_screen.nf (kept separate from LAAVA's own nextflow.config).

params {
    laava_output    = null                   // directory LAAVA published to (its --output)
    sample_id       = null                   // sample id(s); comma-separated for several
    outdir          = 'results'              // where this workflow publishes
    blast_db_dir    = null                   // directory holding the BLAST database files
    blast_db_name   = 'demo_contaminants'    // database name inside blast_db_dir (e.g. core_nt for NCBI)
    taxdump_dir     = null                   // directory with nodes.dmp, names.dmp (merged.dmp optional)
    categories      = "${projectDir}/../scripts/categories.yaml"
    truth           = null                   // spike-in truth TSV (demo data only)
    db_label        = ''                     // override; default comes from the blastn provenance file
    show_validation = false                  // add the spike-in validation table to the report
    tools_image     = 'aav-agent-tools:local'
}

process {
    container = params.tools_image
    cpus      = 1
    memory    = '2 GB'

    withName: 'RUN_BLASTN' {
        cpus   = 4
        memory = '8 GB'      // raise for full NT
    }
    withName: 'CLASSIFY' {
        memory = '4 GB'      // a full NCBI taxdump takes a few hundred MB to load
    }
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

profiles {
    local {
        process.executor = 'local'
    }

    // Untested sketch: fill in the placeholders before use. Batch runs the containers itself.
    // A multi-GB BLAST database should live on shared storage (e.g. EFS) rather than being
    // staged per task from S3.
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'REPLACE_ME'
        aws.region       = 'us-west-2'
        workDir          = 's3://REPLACE_ME/work'
        docker.enabled   = false
    }
}
